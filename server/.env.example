# Server port (optional, defaults to 4000)
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Secret for signing JWT tokens — use a long random string (min 10 chars)
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (optional, defaults to 7d). jsonwebtoken
# format: a number = seconds, or a string like "7d", "12h", "30m".
JWT_EXPIRES_IN=7d

# Clipdrop text-to-image API key
CLIPDROP_API=your-clipdrop-api-key

# Razorpay keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Stripe secret key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Payment currency (optional, defaults to INR)
CURRENCY=INR

# Origin(s) allowed to call this API — the client's own URL. Comma-separate for more than
# one (e.g. a deployed URL + localhost while testing). Optional, defaults to the Vite dev
# server's default port.
CLIENT_URL=http://localhost:5173

# Minimum log level to emit (optional, defaults to info). One of: fatal, error, warn, info,
# debug, trace. Use "debug" locally when you need to see everything.
LOG_LEVEL=info
